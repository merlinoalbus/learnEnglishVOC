# =====================================================
# 🔐 server/.env.example - Configurazione backend (SOLO server-side)
# =====================================================
# Queste variabili NON sono mai esposte al browser.
# Copia in .env (o passa via docker-compose environment) e valorizza.

# Gemini AI API Key (richiesta). Senza key l'endpoint /api/ai/generate risponde 503.
# Ottieni la key da: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Endpoint Gemini (opzionale, default sotto)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Porta di ascolto del backend (default 3001)
PORT=3001

# Rate limit per IP sull'endpoint AI
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Limiti di sicurezza payload
MAX_TEXT_LENGTH=8000
JSON_BODY_LIMIT=32kb

# Timeout verso Gemini (ms)
UPSTREAM_TIMEOUT_MS=30000
